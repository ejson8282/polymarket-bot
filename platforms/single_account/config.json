{
  "mode": "paper_only",
  "runner": {
    "interval_sec": 300
  },
  "sim": {
    "_comment": "施工包01 §B3 模拟器成本模型:费用 bps;滑点=spread/2+impact 封顶 slip_cap;funding 无数据时按 interval_hours 整点",
    "db": "../../data/single_account_paper.db",
    "initial_cash": 10000,
    "taker_fee_bps": 5,
    "maker_fee_bps": 2,
    "default_spread_bps": 10,
    "fixed_impact_bps": 2,
    "slip_cap_bps": 25,
    "funding_interval_hours": 8,
    "daily_loss_stop_pct": 0.02,
    "max_gross_exposure_mult": 1.5,
    "strategies": {
      "_comment": "施工包02 §2 四策略参数(空对象=用代码内 DEFAULTS;字段可逐个覆盖);放 sim 下避免被旧 scorer 误消费(经确认)",
      "funding_carry": {"max_notional_pct": 0.30},
      "momentum_breakout": {"max_notional_pct": 0.30},
      "mean_reversion": {"max_notional_pct": 0.20},
      "rwa_basis": {"max_notional_pct": 0.10}
    }
  },
  "input": {
    "market_snapshot_path": "../../data/single_account_market_snapshot.json"
  },
  "output": {
    "state_path": "../../data/single_account_paper_state.json",
    "decisions_path": "../../data/single_account_decisions.jsonl",
    "log_path": "../../data/single_account_paper_worker.log",
    "pid_path": "../../data/.single_account_paper.pid"
  },
  "risk": {
    "max_weekly_loss_usdc": 10.0,
    "max_open_positions": 2,
    "max_notional_usdc": 100.0,
    "max_leverage": 3.0,
    "max_quote_age_seconds": 60,
    "max_spread_bps": 12.0,
    "min_volume_24h_usdc": 1000000.0,
    "min_score_to_trade": 65.0
  },
  "strategies": {
    "funding_carry_rotation": {
      "enabled": true,
      "label": "Funding Carry Rotation",
      "target_hold_hours": [8, 36],
      "preferred_categories": ["major", "rwa", "commodity"],
      "weight": 1.0
    },
    "trend_momentum_breakout": {
      "enabled": true,
      "label": "Trend / Momentum Breakout",
      "target_hold_hours": [2, 18],
      "preferred_categories": ["major", "rwa", "stock"],
      "weight": 0.9
    },
    "mean_reversion_range": {
      "enabled": true,
      "label": "Mean Reversion / Range",
      "target_hold_hours": [0.5, 6],
      "preferred_categories": ["major"],
      "weight": 0.65
    },
    "rwa_stock_rotation": {
      "enabled": true,
      "label": "RWA / Stock Rotation",
      "target_hold_hours": [12, 72],
      "preferred_categories": ["rwa", "stock", "commodity"],
      "weight": 0.85
    },
    "event_new_listing_momentum": {
      "enabled": true,
      "label": "Event / New Listing Momentum",
      "target_hold_hours": [0.25, 4],
      "preferred_categories": ["new_listing", "low_oi", "alt"],
      "weight": 0.5
    }
  },
  "universe": [
    {"symbol": "BTC", "category": "major"},
    {"symbol": "ETH", "category": "major"},
    {"symbol": "SOL", "category": "major"},
    {"symbol": "HYPE", "category": "alt"},
    {"symbol": "XAU", "category": "commodity"},
    {"symbol": "QQQ", "category": "stock"},
    {"symbol": "NVDA", "category": "stock"},
    {"symbol": "TSLA", "category": "stock"}
  ]
}

