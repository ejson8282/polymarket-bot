<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.codex.predictfun-api-proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PREDICTFUN_PYTHON__</string>
    <string>__PREDICTFUN_CURRENT__/deploy/mac-mini/predictfun_api_proxy.py</string>
    <string>--host</string>
