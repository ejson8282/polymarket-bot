[Unit]
Description=Predict.fun dry-run 完整模拟周期(mode=dry_run,不下真实单)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/polymarket-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/polymarket-bot/.venv/bin/python -m platforms.predictfun.maker.runner --config /home/ubuntu/polymarket-bot/platforms/predictfun/maker/config.mainnet.json --once
NoNewPrivileges=true
UMask=0077
StandardOutput=append:/home/ubuntu/polymarket-bot/data/predictfun_dryrun.log
StandardError=append:/home/ubuntu/polymarket-bot/data/predictfun_dryrun.log
